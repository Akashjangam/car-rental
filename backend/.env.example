# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend / Client Origin URL (supports comma-separated origins for production)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
MONGO_URI=your_mongodb_connection_string

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key

# Cloudinary Credentials (Car image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Credentials (Payment processing)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Brevo Email Service (Transactional email notifications)
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=DriveNow Car Rental

# Optional SMTP Settings (if using SMTP fallback)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
