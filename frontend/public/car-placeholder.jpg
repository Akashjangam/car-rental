<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <!-- Background -->
  <rect width="400" height="300" fill="#f1f5f9"/>
  
  <!-- Car body -->
  <rect x="80" y="120" width="240" height="100" rx="10" fill="#94a3b8" opacity="0.5"/>
  
  <!-- Car top -->
  <path d="M 120 120 L 160 80 L 240 80 L 280 120" fill="#94a3b8" opacity="0.5"/>
  
  <!-- Windows -->
  <rect x="170" y="95" width="60" height="25" rx="3" fill="#e0f2fe" opacity="0.7"/>
  <rect x="110" y="140" width="45" height="35" rx="3" fill="#e0f2fe" opacity="0.7"/>
  <rect x="245" y="140" width="45" height="35" rx="3" fill="#e0f2fe" opacity="0.7"/>
  
  <!-- Wheels -->
  <circle cx="140" cy="220" r="20" fill="#334155"/>
  <circle cx="140" cy="220" r="15" fill="#cbd5e1"/>
  <circle cx="260" cy="220" r="20" fill="#334155"/>
  <circle cx="260" cy="220" r="15" fill="#cbd5e1"/>
  
  <!-- Headlights -->
  <circle cx="95" cy="145" r="8" fill="#fef08a"/>
  <circle cx="95" cy="165" r="8" fill="#fef08a"/>
  
  <!-- Text -->
  <text x="200" y="270" text-anchor="middle" font-size="16" fill="#64748b" font-family="system-ui">
    Car Placeholder
  </text>
</svg>